# OFI7 - Exemplo de variáveis de ambiente (.env)
#
# Copie este arquivo para ".env" e preencha os valores abaixo.
# Não commit o arquivo ".env" real (ele já está no .gitignore).
#
# No Windows/PowerShell você também pode setar no sistema/perfil;
# No PythonAnywhere: vá em Web > Environment variables e defina cada linha.

# ====== WhatsApp UAIZAPI ======
# Token ou Secret para validar a assinatura do webhook (um dos dois basta)
UAIZAPI_WEBHOOK_TOKEN=
UAIZAPI_WEBHOOK_SECRET=

# Credenciais para DOWNLOAD de anexos (imagens/PDF enviados pelo WhatsApp).
# Use os mesmos valores do seu painel UAIZAPI.
# Normalmente basta UM destes: UAIZAPI_API_KEY (recomendado) ou UAIZAPI_TOKEN.
UAIZAPI_INSTANCE=
UAIZAPI_API_KEY=
UAIZAPI_TOKEN=

# (opcional) se o token de download for diferente do token geral
UAIZAPI_DOWNLOAD_TOKEN=

# ====== Django ======
# Manter vazio por padrão (só mudar em produção se souber o que faz)
# DJANGO_SETTINGS_MODULE=controle_oficina.settings
